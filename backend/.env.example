APP_PORT=8080

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_management

# JWT (isi dengan string acak minimal 32 karakter)
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Origin frontend yang diizinkan CORS (sama persis dengan alamat di browser)
CORS_ORIGIN=http://127.0.0.1:5500

# Akun Admin pertama, dipakai oleh: go run ./cmd/seed
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=